\generate{
  \file{numodel.sty}{\from{numodel.dtx}{package}}
  \file{numodel-EN.def}{\from{numodel.dtx}{EN}}
  \file{numodel-NL.def}{\from{numodel.dtx}{NL}}
}

\obeyspaces
\Msg{***********************************************************}
\Msg{*}
\Msg{* Generated files:}
\Msg{*   numodel.sty, numodel-EN.def, numodel-NL.def}
\Msg{*}
\Msg{* To install into your local TeX tree, run}
\Msg{*   l3build install}
\Msg{* from the bundle root, or copy the generated files plus the}
\Msg{* hand-written numodel.lua into a kpse-searched directory.}
\Msg{*}
\Msg{* Additional language tables can be supplied as a stand-alone}
\Msg{* numodel-<LANG>.def file alongside numodel.sty; no package}
\Msg{* rebuild is required.}
\Msg{*}
\Msg{* The package documentation is generated by running}
\Msg{*   l3build doc}
\Msg{* (which calls lualatex on numodel-manual.tex; the .dtx itself}
\Msg{* is pure docstrip source and is no longer typesettable).}
\Msg{*}
\Msg{***********************************************************}

\endbatchfile
