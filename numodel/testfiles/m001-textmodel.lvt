% Regression test: \textmodel renders rules with the syntax-default
% keyword table (English / XMILE-style).
\input{regression-test.tex}
\documentclass{article}
\usepackage[syntax=EN]{numodel}
\begin{document}
\START
\OMIT
\newmodelprefix{ball}
\mvar{T}{t}{0}{\s}{2}{system}
\mvar{Dt}{dt}{0.1}{\s}{2}{system}
\mvar{Y}{y}{100}{\m}{2}{stock}
\mvar{V}{v}{0}{\m\per\s}{2}{stock}
\mvar{G}{g}{-9.81}{\m\per\s\squared}{2}{constant}
\mrule{V}{\ballV + \ballG * \ballDt}
\mrule{Y}{\ballY + \ballV * \ballDt}
\mstop{\ballY <= 0}
\TIMO
\TYPE{=== \string\textmodel\space output ===}
\textmodel
\end{document}
