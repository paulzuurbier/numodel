% Regression test: \mvar, \mrule, \mruletext and \mstop hand the complete
% model to Lua, so that numodel.get_model (the export API used by
% numodel-coach) sees start values, units, significant figures, every
% row in \textmodel order and the stop condition.  Covers a start value
% given as an expression, a variable without start value, a starred
% ternary, a free-text row, an aliased rule and a model without \mstop.
% maxiter mirrors \numodelsetup.
\input{regression-test.tex}
\documentclass{article}
\usepackage[syntax=NL]{numodel}
\begin{document}
\START
\OMIT
\newmodelprefix{ball}
\mvar{T}{t}{0}{\s}{2}{systeem}
\mvar{Dt}{dt}{0.05}{\s}{2}{systeem}
\mvar{V}{v}{0}{\m\per\s}{3}{voorraad}
\mvar{Y}{y}{100}{\m}{3}{voorraad}
\mvar{G}{g}{-9.81}{\m\per\s\squared}{3}{constante}
\mrule{V}{\ballV + \ballG * \ballDt}
\mrule{Y}{\ballY + \ballV * \ballDt}
\mrule{T}{\ballT + \ballDt}
\mstop{\ballY <= 2}
\newmodelprefix{osc}
\mvar{T}{t}{0}{\s}{2}{systeem}
\mvar{Dt}{\Delta t}{0.01}{\s}{2}{systeem}
\mvar{Fres}{F_{\text{res}}}{}{\newton}{3}{hulp}
\mvar{K}{k}{2*3}{\newton\per\m}{3}{constante}
\mvar{A}{a}{1}{\m\per\s\squared}{3}{hulp}
\mrule{Fres}{-\oscK * \oscA}
\mrule*{A}{\oscT < 1 ? \oscA + 1 : \oscA - 1}
\mruletext{\text{(rest weggelaten)}}
\mrule[aliasright=\cdots]{T}{\oscT + \oscDt}
\numodelsetup{maxiter=5000}
\TIMO
\TYPE{=== Free fall ===}
\directlua{
  for line in numodel.dump_model("ball"):gmatch("[^\string\n]+") do
    texio.write_nl(line)
  end}
\TYPE{=== Mixed rows, no stop condition ===}
\directlua{
  for line in numodel.dump_model("osc"):gmatch("[^\string\n]+") do
    texio.write_nl(line)
  end}
\TYPE{=== Unknown prefix ===}
\directlua{texio.write_nl(tostring(numodel.get_model("nope")))}
\TYPE{=== End ===}
\end{document}
