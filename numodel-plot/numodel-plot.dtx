%
% \DoNotIndex{\newcommand,\newenvironment,\def,\edef,\let,\global,
%   \RequirePackage,\usepgfplotslibrary,\pgfplotsset,\ProvidesPackage,
%   \NeedsTeXFormat,\makeatletter,\makeatother,\endinput,\providecommand,
