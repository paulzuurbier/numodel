% Regression test: \calcplotdims rounds the axis range to a clean
% tick lattice and produces consistent xmin/xmax/ymin/ymax + tick
% increments.
\input{regression-test.tex}
\documentclass{article}
\usepackage{siunitx}
\usepackage{numodel-plot}
\begin{document}
\START
\OMIT
\def\xmin{0}\def\xmax{9.7}
\def\ymin{0}\def\ymax{4.85}
\calcplotdims
\TIMO
\TYPE{=== \string\calcplotdims\space results ===}
\TYPE{x range: \xmin\space.. \xmax}
\TYPE{y range: \ymin\space.. \ymax}
\TYPE{x per cm: \xtickdistance}
\TYPE{y per cm: \ytickdistance}
\TYPE{x width: \xcm\space cm}
\TYPE{y height: \ycm\space cm}
\TYPE{=== equal: the same amount per cm on both axes ===}
\OMIT
\numodelplotsetup{equal}
\def\xmin{-10}\def\xmax{10}
\def\ymin{-3}\def\ymax{3}
\calcplotdims
\TIMO
\TYPE{x range: \xmin\space.. \xmax, \xtickdistance\space per cm, \xcm\space cm}
\TYPE{y range: \ymin\space.. \ymax, \ytickdistance\space per cm, \ycm\space cm}
\end{document}
